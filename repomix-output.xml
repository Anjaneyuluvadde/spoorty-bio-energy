'use client';

import React, { useEffect, useState } from 'react';
import { motion, AnimatePresence } from 'framer-motion';

export default function Preloader() {
  const [progress, setProgress] = useState(0);
  const [isLoaded, setIsLoaded] = useState(false);

  useEffect(() => {
    // Prevent scrolling while loading
    document.body.style.overflow = 'hidden';

    // Simulate progress increments up to 100% over 1.4s
    const startTime = Date.now();
    const duration = 1200; // ms

    const updateProgress = () => {
      const elapsed = Date.now() - startTime;
      const calculated = Math.min(100, Math.floor((elapsed / duration) * 100));
      
      setProgress(calculated);

      if (elapsed < duration) {
        requestAnimationFrame(updateProgress);
      } else {
        setProgress(100);
        // Delay slightly for visual hold before fading out
        setTimeout(() => {
          setIsLoaded(true);
          document.body.style.overflow = '';
        }, 300);
      }
    };

    requestAnimationFrame(updateProgress);

    return () => {
      document.body.style.overflow = '';
    };
  }, []);

  return (
    <AnimatePresence>
      {!isLoaded && (
        <motion.div
          initial={{ opacity: 1 }}
          exit={{ 
            opacity: 0,
            scale: 1.05,
            filter: 'blur(10px)',
            transition: { duration: 0.5, ease: [0.16, 1, 0.3, 1] } 
          }}
          className="fixed inset-0 z-[9999] bg-dark flex flex-col items-center justify-center text-white"
        >
          {/* Noise effect */}
          <div className="absolute inset-0 bg-noise pointer-events-none" />

          {/* SVG Vector Drawing Logo */}
          <div className="relative flex flex-col items-center select-none z-10">
            <svg 
              className="w-28 h-28 text-white mb-6" 
              viewBox="0 0 100 100" 
              fill="none" 
              xmlns="http://www.w3.org/2000/svg"
            >
              {/* Outer Shield Path */}
              <motion.path
                d="M 50 10 L 82 26 L 82 62 L 50 88 L 18 62 L 18 26 Z"
                stroke="currentColor"
                strokeWidth="2.5"
                strokeLinecap="round"
                strokeLinejoin="round"
                initial={{ pathLength: 0 }}
                animate={{ pathLength: 1 }}
                transition={{ duration: 1.1, ease: 'easeInOut' }}
              />
              {/* Inner Leaf Path */}
              <motion.path
                d="M 50 32 C 50 32 37 45 37 57 C 37 66 45 70 50 70 C 55 70 63 66 63 57 C 63 45 50 32 50 32 Z"
                stroke="#22C55E"
                strokeWidth="2.5"
                strokeLinecap="round"
                strokeLinejoin="round"
                initial={{ pathLength: 0 }}
                animate={{ pathLength: 1 }}
                transition={{ duration: 0.9, delay: 0.2, ease: 'easeInOut' }}
              />
            </svg>

            {/* Brand Title */}
            <motion.h1 
              initial={{ opacity: 0, y: 10 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ delay: 0.4, duration: 0.6 }}
              className="font-heading font-extrabold text-2xl tracking-widest text-white mb-2"
            >
              SPOORTY <span className="text-secondary">BIO ENERGY</span>
            </motion.h1>

            <motion.p
              initial={{ opacity: 0 }}
              animate={{ opacity: 0.5 }}
              transition={{ delay: 0.6, duration: 0.5 }}
              className="font-sans text-xs tracking-wider text-gray-400 uppercase mb-8"
            >
              Renewable Energy & Biogas Engineering
            </motion.p>

            {/* Counter percentage indicator */}
            <div className="font-heading font-bold text-lg text-secondary tabular-nums min-w-[3rem] text-center mb-2">
              {progress}%
            </div>

            {/* Horizontal progress bar */}
            <div className="w-56 h-[2px] bg-white/10 rounded-full overflow-hidden relative">
              <motion.div
                className="absolute top-0 left-0 bottom-0 bg-secondary"
                style={{ width: `${progress}%` }}
                layoutId="progressBar"
              />
            </div>
          </div>
        </motion.div>
      )}
    </AnimatePresence>
  );
}
