              {
                icon: Phone,
                title: 'Call Us',
                details: '+91 98765 43210',
                sub: 'Mon - Sat, 9am - 6pm'
              },
              {
                icon: Mail,
                title: 'Email Us',
                details: 'info@spoortybioenergy.com',
                sub: 'Response within 24 hours'
              },
              {
                icon: MapPin,
                title: 'Visit Us',
                details: '123 Green Energy Park',
                sub: 'Hyderabad, Telangana, India'
              },
              {
                icon: Clock,
                title: 'Working Hours',
                details: '09:00 AM - 06:00 PM',
                sub: 'Closed on Sundays'
              }
            ].map((card, idx) => (
