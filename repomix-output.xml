<file path="src/app/projects/page.tsx">
'use client';

import React, { useState, useEffect, useRef } from 'react';
import Navbar from '@/components/Navbar';
import Footer from '@/components/Footer';
import PageHeader from '@/components/PageHeader';
import ScrollReveal from '@/components/ScrollReveal';
import ThreeDTilt from '@/components/ThreeDTilt';
import { motion, AnimatePresence } from 'framer-motion';
import { Calendar, MapPin } from 'lucide-react';
import { gsap } from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';

const categories = ['All', 'Agriculture', 'Dairy', 'Industrial', 'Municipal'];

const projects = [
  {
    id: 1,
    image: '/images/hero.jpg',
    title: '75 TPD Biogas Plant',
    category: 'Dairy',
    location: 'Punjab, India',
    industry: 'Dairy Industry',
    capacity: '75 Tons Per Day',
    achievement: 'Generates 1.2MW power & organic fertilizer',
    year: '2025'
  },
  {
    id: 2,
    image: '/images/biomethane.jpg',
    title: '50 TPD Biomethane Upgrading Plant',
    category: 'Industrial',
    location: 'Maharashtra, India',
    industry: 'Food Processing Sector',
    capacity: '50 Tons Per Day',
    achievement: '99% pure biomethane grid injection',
    year: '2024'
  },
  {
    id: 3,
    image: '/images/about.jpg',
    title: '100 TPD High-Rate Digester',
    category: 'Industrial',
    location: 'Uttar Pradesh, India',
    industry: 'Sugar & Distillery Sector',
    capacity: '100 Tons Per Day',
    achievement: 'Treated spent wash with high COD removal',
    year: '2025'
  },
  {
    id: 4,
    image: '/images/hero.jpg',
    title: '30 TPD Agri-Waste Biogas Plant',
    category: 'Agriculture',
    location: 'Haryana, India',
    industry: 'Agricultural Farm Cooperative',
    capacity: '30 Tons Per Day',
    achievement: 'Converts paddy straw to clean cooking gas',
    year: '2023'
  },
  {
    id: 5,
    image: '/images/biomethane.jpg',
    title: '20 TPD Co-Digestion Plant',
    category: 'Agriculture',
    location: 'Karnataka, India',
    industry: 'Sugar & Livestock Mix',
    capacity: '20 Tons Per Day',
    achievement: 'Offsets 4,500 tons CO2 emissions annually',
    year: '2024'
  },
  {
    id: 6,
    image: '/images/engineer.jpg',
    title: 'Municipal Solid Waste (MSW) Biogas',
    category: 'Municipal',
    location: 'Hyderabad, India',
    industry: 'City Corporation Project',
    capacity: '120 Tons Per Day',
    achievement: 'Fuels municipal garbage trucks via Bio-CNG',
    year: '2026'
  }
];

export default function ProjectsPage() {
  const [activeCategory, setActiveCategory] = useState('All');
  const gridRef = useRef<HTMLDivElement>(null);

  const filteredProjects = activeCategory === 'All'
    ? projects
    : projects.filter(p => p.category === activeCategory);

  useEffect(() => {
    // Register GSAP ScrollTrigger
    gsap.registerPlugin(ScrollTrigger);
    
    const container = gridRef.current;
    if (!container) return;

    const cards = container.querySelectorAll('.project-card-inner');
    if (!cards || cards.length === 0) return;

    // Skip stacked animations on mobile layouts
    const isMobile = window.matchMedia('(max-width: 768px)').matches;
    if (isMobile) {
      gsap.set(cards, { x: 0, y: 0, rotation: 0, scale: 1 });
      return;
    }

    // Stack cards initially and calculate exact center offsets relative to the grid container
    cards.forEach((card, index) => {
      const rotation = (index - 2.5) * 5; // staggered rotation stack
      const offsetX = (index - 2.5) * 12;
      const offsetY = index % 2 === 0 ? -15 : 15;

      gsap.set(card, {
        x: () => {
          const containerRect = container.getBoundingClientRect();
          const cardRect = card.getBoundingClientRect();
          const centerX = containerRect.width / 2 - cardRect.width / 2;
          const currentX = card.getBoundingClientRect().left - containerRect.left;
          return centerX - currentX + offsetX;
        },
        y: () => {
          const containerRect = container.getBoundingClientRect();
          const cardRect = card.getBoundingClientRect();
          const centerY = containerRect.height / 3 - cardRect.height / 2;
          const currentY = card.getBoundingClientRect().top - containerRect.top;
          return centerY - currentY + offsetY;
        },
        rotation: rotation,
        scale: 0.92,
        z: -50,
      });
    });

    // Timeline: overlapping stack -> shuffle flyouts -> grid alignment
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: container,
        start: 'top 85%',
        end: 'top 35%',
        scrub: 1.2,
      }
    });

    tl.to(cards, {
      x: (i) => (i % 2 === 0 ? -90 : 90),
      rotation: (i) => (i % 2 === 0 ? -12 : 12),
      scale: 0.95,
      duration: 0.4,
      stagger: 0.05,
    })
    .to(cards, {
      x: 0,
      y: 0,
      rotation: 0,
      scale: 1,
      z: 0,
      duration: 0.8,
      ease: 'power2.out',
      stagger: 0.05,
    });

    return () => {
      ScrollTrigger.getAll().forEach(t => t.kill());
    };
  }, [activeCategory]);

  return (
    <>
      <Navbar />

      <main className="flex-grow bg-[#F8FAFC]">
        {/* Page Header */}
        <PageHeader 
          title="Our Projects"
          description="A showcase of our high-capacity biogas plants and biomethane upgrading facilities across the region."
          breadcrumbs={[
            { name: 'Home', href: '/' },
            { name: 'Projects' }
          ]}
        />

        {/* Filters Section */}
        <section className="pt-16 pb-8 max-w-[1440px] mx-auto px-6 md:px-12 flex justify-center">
          <ScrollReveal>
            <div className="flex flex-wrap gap-2.5 bg-white p-2 rounded-2xl border border-gray-100 shadow-sm">
              {categories.map((cat) => (
                <button
                  key={cat}
                  onClick={() => setActiveCategory(cat)}
                  className={`font-sans text-sm font-semibold py-2.5 px-5 rounded-xl transition-all cursor-pointer ${
                    activeCategory === cat
                      ? 'bg-primary text-white shadow-md'
                      : 'text-gray-500 hover:text-primary hover:bg-gray-50'
                  }`}
                >
                  {cat}
                </button>
              ))}
            </div>
          </ScrollReveal>
        </section>

        {/* Projects Grid Section */}
        <section className="pb-24 max-w-[1440px] mx-auto px-6 md:px-12">
          <motion.div 
            ref={gridRef}
            layout 
            className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
          >
            <AnimatePresence mode="popLayout">
              {filteredProjects.map((project) => (
                <motion.div
                  key={project.id}
                  layout
                  initial={{ opacity: 0, scale: 0.95 }}
                  animate={{ opacity: 1, scale: 1 }}
                  exit={{ opacity: 0, scale: 0.95 }}
                  transition={{ duration: 0.4 }}
                  className="h-full"
                >
                  <ThreeDTilt maxRotate={6} className="h-full rounded-3xl">
                    <div className="project-card-inner bg-white rounded-3xl overflow-hidden border border-gray-100 hover:border-primary/20 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col h-full group glow-border-animate shine-effect">
                      {/* Image container */}
                      <div className="relative h-64 overflow-hidden shrink-0">
                        <img 
                          src={project.image} 
                          alt={project.title} 
                          className="object-cover w-full h-full transition-transform duration-700 group-hover:scale-105"
                        />
                        <div className="absolute inset-0 bg-dark/20 group-hover:bg-dark/10 transition-all duration-300" />
                        
                        {/* Floating Category Badge */}
                        <div className="absolute top-4 left-4 bg-secondary text-white font-sans text-xs font-bold py-1 px-3.5 rounded-full shadow-md">
                          {project.category}
                        </div>
                      </div>

                      {/* Card Info */}
                      <div className="p-6 md:p-8 flex-grow flex flex-col justify-between">
                        <div>
                          {/* Meta information */}
                          <div className="flex flex-wrap gap-4 text-xs text-gray-400 font-sans font-medium mb-3">
                            <span className="flex items-center gap-1">
                              <MapPin className="h-3.5 w-3.5 text-primary" />
                              {project.location}
                            </span>
                            <span className="flex items-center gap-1">
                              <Calendar className="h-3.5 w-3.5 text-primary" />
                              Commissioned: {project.year}
                            </span>
                          </div>

                          {/* Project Title */}
                          <h3 className="font-heading font-extrabold text-2xl text-dark mb-2 group-hover:text-primary transition-colors">
                            {project.title}
                          </h3>

                          {/* Industry Details */}
                          <p className="font-sans text-sm font-semibold text-secondary mb-4">
                            {project.industry}
                          </p>
                        </div>

                        {/* Stats details inside card */}
                        <div className="border-t border-gray-100 pt-6 mt-4 flex flex-col gap-3 font-sans">
                          <div className="flex justify-between items-center text-sm">
                            <span className="text-gray-400 font-medium">Capacity</span>
                            <span className="text-dark font-bold">{project.capacity}</span>
                          </div>
                          <div className="flex justify-between items-start text-sm">
                            <span className="text-gray-400 font-medium shrink-0">Impact</span>
                            <span className="text-primary font-semibold text-right leading-tight">{project.achievement}</span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </ThreeDTilt>
                </motion.div>
              ))}
            </AnimatePresence>
          </motion.div>
        </section>
      </main>

      <Footer />
    </>
  );
}
</file>

