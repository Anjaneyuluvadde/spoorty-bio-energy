                      className="w-full inline-flex items-center justify-center gap-2 bg-primary hover:bg-primary/95 text-white font-sans font-semibold py-3 px-6 rounded-xl transition-all shadow-md active:scale-95 cursor-pointer disabled:opacity-50"
